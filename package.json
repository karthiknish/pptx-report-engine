{
  "name": "pptx-report-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Describe a deck as JSON, get a designed, layout-checked PowerPoint file.",
  "main": "src/index.ts",
  "scripts": {
    "sample": "tsx scripts/render.ts",
